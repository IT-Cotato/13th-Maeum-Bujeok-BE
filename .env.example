# Database Configuration
# 로컬 개발 환경의 DB 포트를 설정합니다. (기본값: 3306)
DB_PORT=3306
# 로컬 MySQL 비밀번호를 입력합니다.
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration
# 32바이트 이상의 무작위 키를 Base64로 인코딩한 값을 사용합니다.
JWT_SECRET=replace_with_base64_encoded_32_byte_secret
# Access Token 유효시간: 30분
JWT_ACCESS_TOKEN_EXPIRATION=30m
# Refresh Token 유효시간 설정: 14일 (현재 발급 기능은 미구현)
JWT_REFRESH_TOKEN_EXPIRATION=14d
JWT_ISSUER=maumbujeok

# OAuth2 Google Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMS CoolSMS/Solapi Configuration
COOLSMS_API_KEY=your_coolsms_api_key_here
COOLSMS_API_SECRET=your_coolsms_api_secret_here
COOLSMS_SENDER_NUMBER=your_coolsms_sender_number_here
# AI Provider Configuration
# 로컬 기본값은 fake이며, 실제 OpenAI 호출 시 openai로 변경합니다.
AI_PROVIDER=fake
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT=120s
OPENAI_MAX_ATTEMPTS=2
AI_NEGATIVE_THRESHOLD=70
